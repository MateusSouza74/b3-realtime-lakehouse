# Copie para .env APENAS se quiser customizar. O projeto sobe sem nenhum .env.
# cp .env.example .env

# ---------------------------------------------------------------------------
# Fonte de dados (brapi.dev)
# ---------------------------------------------------------------------------
# Sem token, apenas os tickers de sandbox funcionam:
#   PETR4, VALE3, ITUB4, MGLU3   (sem token e sem compromisso)
# Com token do plano Free: 15.000 requisicoes/mes e 1 ticker por chamada.
BRAPI_TOKEN=

TICKERS=PETR4,VALE3,ITUB4,MGLU3

# Quantos tickers cabem em UMA chamada HTTP:
#   Free = 1 | Startup = 10 | Pro = 20
BRAPI_TICKERS_PER_REQUEST=1

# Intervalo do polling em segundos.
# Atencao a cota: 4 tickers x 1 ticker/chamada a cada 15s = ~690k req/mes.
# Isso so e sustentavel nos tickers de sandbox (sem token).
POLL_INTERVAL_SECONDS=15

# brapi     -> sempre a API real (fora do pregao o preco fica congelado)
# simulated -> sempre random walk local (demo 24/7, nao consome cota)
# auto      -> brapi no pregao da B3, simulado fora dele  [default]
# Todo evento carrega o campo `source`, entao dado real e simulado nunca
# se confundem em nenhuma camada.
SOURCE_MODE=auto

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
KAFKA_TOPIC=b3.quotes.raw
TRIGGER_SECONDS=15
BATCH_SCHEDULE_CRON=*/5 * * * *
DASHBOARD_REFRESH_SECONDS=10
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Opcional: webhook de Slack ou Discord para os alertas de falha.
# Vazio = alerta so no log do Airflow e em /data/alerts/alerts.jsonl
ALERT_WEBHOOK_URL=
